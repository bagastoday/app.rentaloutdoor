APP_NAME="Rental Outdoor"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# ==== LOCAL (XAMPP / MySQL) ====
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=db_rental_outdoor
DB_USERNAME=root
DB_PASSWORD=

# ==== PRODUCTION (Supabase / PostgreSQL) ====
# Ganti nilai di atas dengan ini saat deploy ke Render.com:
# DB_CONNECTION=pgsql
# DB_HOST=xxxxxxx.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=xxxxxxxxxxxx

FILESYSTEM_DISK=public

MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxxxxxxxxxxxxxxxxx
MIDTRANS_IS_PRODUCTION=false
